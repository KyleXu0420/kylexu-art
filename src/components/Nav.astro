---
import { href, isCurrent } from '../lib/url';
const path = Astro.url.pathname;
const links = [
  { label: 'Work', to: '/' },
  { label: 'About', to: '/about' },
];
---
<header class="nav">
  <div class="col">
    <a class="brand" href={href('/')}>Kyle Xu</a>
    <nav class="pill" aria-label="Primary">
      {links.map((l) => (
        <a href={href(l.to)} aria-current={isCurrent(path, l.to) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
