---
// A case figure: the image in a 24px frame at its own ratio (never cropped, never stretched),
// served as avif + webp at the row's widths, with one caption — the evidence label first, then
// what the frame shows. `half` puts it on six columns for a pair; `narrow` on the words' column.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Evidence = 'Shipped' | 'Prototype' | 'Concept' | 'Supporting state';
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  evidence: Evidence;
  half?: boolean;
  narrow?: boolean;
  loading?: 'eager' | 'lazy';
}
const { src, alt, caption, evidence, half = false, narrow = false, loading = 'lazy' } = Astro.props;
const full = { widths: [720, 1100, 1600, 2600], sizes: '(max-width: 767px) 100vw, (max-width: 1440px) 87vw, 1248px' };
const pair = { widths: [480, 720, 1100, 1300], sizes: '(max-width: 767px) 100vw, (max-width: 1440px) 42vw, 612px' };
const words = { widths: [720, 1100, 1440], sizes: '(max-width: 1023px) 100vw, (max-width: 1440px) 50vw, 718px' };
const p = half ? pair : narrow ? words : full;
---
<figure class:list={['fig', { half, narrow }]}>
  <div class="frame"><Picture src={src} formats={['avif', 'webp']} widths={p.widths} sizes={p.sizes} alt={alt} loading={loading} decoding="async" /></div>
  <figcaption class="meta"><b>{evidence}</b> · {caption}</figcaption>
</figure>
