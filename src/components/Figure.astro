---
// A case figure: one frame, or a set of frames under one caption. Every frame is the image in a
// 24px frame at its own ratio (never cropped by the frame, never stretched), served as avif + webp
// at the widths it is shown at. The caption is one sentence saying what to look at; the evidence
// label follows it on the same line after the eyebrow's middle dot — or, when the frames of a set
// differ in status, each frame carries its own label on the line above it and the caption carries
// none. A set lays out as strips stacked on the full row (`stack`; with `narrow`, on the words'
// column) or as two frames side by side on the words' column at one height (`pair`). An item may
// carry a short label above its frame — a name and a note — set in the page's type, never in the
// bitmap. A single sits on the full row, on the words' column (`narrow`), or, for a detail cut
// from a screen, on five of the words' seven columns (`crop`).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Evidence = 'Shipped' | 'Prototype' | 'Concept' | 'Supporting state';
export interface Item { src: ImageMetadata; alt: string; name?: string; note?: string; evidence?: Evidence }
interface Props {
  src?: ImageMetadata;
  alt?: string;
  items?: Item[];
  set?: 'stack' | 'pair';
  caption: string;
  evidence?: Evidence;
  narrow?: boolean;
  crop?: boolean;
  loading?: 'eager' | 'lazy';
}
const { src, alt = '', items, set = 'stack', caption, evidence, narrow = false, crop = false, loading = 'lazy' } = Astro.props;
// every frame carries a label: the figure's, or its own
if (!evidence && !(items && items.every((it) => it.evidence))) throw new Error(`Figure "${caption.slice(0, 40)}…": no evidence label`);
const perItem = !!items && !evidence;

const full = { widths: [720, 1100, 1600, 2600], sizes: '(max-width: 767px) 100vw, (max-width: 1440px) 87vw, 1248px' };
const words = { widths: [720, 1100, 1440], sizes: '(max-width: 1023px) 100vw, (max-width: 1440px) 50vw, 718px' };
const half = { widths: [320, 480, 800], sizes: '(max-width: 1023px) 48vw, (max-width: 1440px) 28vw, 400px' };
const detail = { widths: [480, 720, 1012], sizes: '(max-width: 767px) 100vw, (max-width: 1023px) 58vw, 506px' };
const sizeFor = () => {
  if (!items) return crop ? detail : narrow ? words : full;
  if (set === 'pair') return half;
  return narrow ? words : full;
};
// never ask for a width the source does not have; the source's own width is always the last
const widthsFor = (im: ImageMetadata, p: { widths: number[] }) => [...p.widths.filter((w) => w < im.width), im.width];
const p = sizeFor();
// a pair shares one height: each column as wide as its frame's ratio
const cols = items && set === 'pair' ? items.map((it) => `${(it.src.width / it.src.height).toFixed(3)}fr`).join(' ') : undefined;
---
<figure class:list={['fig', { narrow, crop, stack: items && set === 'stack', pair: items && set === 'pair' }]}>
  {items ? (
    <div class="frames" style={cols && `--cols: ${cols}`}>
      {items.map((it) => (
        <div class="item">
          {(it.name || it.note || perItem) && (
            <span class="meta lab">
              {it.name && <b>{it.name}</b>}{it.name && it.note && ' — '}{it.note}
              {perItem && <Fragment>{(it.name || it.note) && ' '}<b>· {it.evidence}</b></Fragment>}
            </span>
          )}
          <div class="frame"><Picture src={it.src} formats={['avif', 'webp']} widths={widthsFor(it.src, p)} sizes={p.sizes} alt={it.alt} loading={loading} decoding="async" /></div>
        </div>
      ))}
    </div>
  ) : (
    <div class="frame"><Picture src={src as ImageMetadata} formats={['avif', 'webp']} widths={widthsFor(src as ImageMetadata, p)} sizes={p.sizes} alt={alt} loading={loading} decoding="async" /></div>
  )}
  <figcaption class="meta">{caption}{evidence && <Fragment> <b>· {evidence}</b></Fragment>}</figcaption>
</figure>
