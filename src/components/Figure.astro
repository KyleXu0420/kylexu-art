---
// A case figure: one frame, or a set of frames under one caption. Every frame is the image in a
// 24px frame at its own ratio (never cropped by the frame, never stretched), served as avif + webp
// at the widths it is shown at. The caption is one sentence saying what to look at. The evidence
// label has one rule: a single carries it in the caption, after the eyebrow's middle dot; a set
// carries it on each frame's own label line above the frame, with the frame's name and note, set
// in the page's type, never in the bitmap. A set lays out as strips stacked on the full row
// (`stack`) or as four frames across the row at one height (`four`). Every figure sits on the
// full row: one right edge for the page's images, the words' measure for its text.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Evidence = 'Shipped' | 'Prototype' | 'Concept' | 'Supporting state';
export interface Item { src: ImageMetadata; alt: string; evidence: Evidence; name?: string; note?: string }
interface Props {
  src?: ImageMetadata;
  alt?: string;
  evidence?: Evidence;
  items?: Item[];
  set?: 'stack' | 'four';
  caption: string;
  loading?: 'eager' | 'lazy';
}
const { src, alt = '', evidence, items, set = 'stack', caption, loading = 'lazy' } = Astro.props;
if (!items && !evidence) throw new Error(`Figure "${caption.slice(0, 40)}…": no evidence label`);

const full = { widths: [720, 1100, 1600, 2600], sizes: '(max-width: 767px) 100vw, (max-width: 1440px) 87vw, 1248px' };
const quarter = { widths: [300, 480, 640], sizes: '(max-width: 767px) 48vw, (max-width: 1440px) 21vw, 294px' };
const p = items && set === 'four' ? quarter : full;
// never ask for a width the source does not have; the source's own width is always the last
const widthsFor = (im: ImageMetadata) => [...p.widths.filter((w) => w < im.width), im.width];
---
<figure class:list={['fig', { stack: items && set === 'stack', four: items && set === 'four' }]}>
  {items ? (
    <div class="frames">
      {items.map((it) => (
        <div class="item">
          <span class="meta lab">
            {it.name && <b>{it.name}</b>}{it.name && it.note && ' — '}{it.note}{(it.name || it.note) && ' '}<b>· {it.evidence}</b>
          </span>
          <div class="frame"><Picture src={it.src} formats={['avif', 'webp']} widths={widthsFor(it.src)} sizes={p.sizes} alt={it.alt} loading={loading} decoding="async" /></div>
        </div>
      ))}
    </div>
  ) : (
    <div class="frame"><Picture src={src as ImageMetadata} formats={['avif', 'webp']} widths={widthsFor(src as ImageMetadata)} sizes={p.sizes} alt={alt} loading={loading} decoding="async" /></div>
  )}
  <figcaption class="meta">{caption}{evidence && !items && <Fragment> <b>· {evidence}</b></Fragment>}</figcaption>
</figure>
