---
// A work's page: the case grammar at the title size. The header row — the title and its tombstone on
// the label column, what it is and what to expect on the reading column, Enter at the row's edge —
// then the film in the page's one big frame (click to play, with sound), the facts, the statement with
// the stills beneath it sized by span and never cropped, and a close that offers
// Enter again. The page stays white; the black and the warm light are the work's, inside its frames.
// The live piece runs at /art/vellum-stacks/live, its own page with its own type and a way back.
import { getImage } from 'astro:assets';
import Sheet from '../../../layouts/Sheet.astro';
import Figure from '../../../components/Figure.astro';
import CursorLabel from '../../../components/CursorLabel.astro';
import { href } from '../../../lib/url';
import '../../../styles/home.css';
import '../../../styles/case.css';
import '../../../styles/art.css';
import poster from '../../../assets/img/art/vellum-poster.jpg';
import approach from '../../../assets/img/art/vellum-02-approach.jpg';
import reading from '../../../assets/img/art/vellum-03-reading.jpg';
import above from '../../../assets/img/art/vellum-04-above.jpg';
import skyline from '../../../assets/img/art/vellum-05-skyline.jpg';

const still = await getImage({ src: poster, width: 1600, format: 'webp' });
const live = href('/art/vellum-stacks/live');
---
<Sheet
  title="The Vellum Stacks — Kyle Xu"
  description="The Vellum Stacks (2026), an interactive spatial artwork by Kyle Xu: an impossible archive of translucent paper over black water that opens where it is read. WebGL, sound generated in the browser."
  ogImage="/og-vellum-stacks.jpg"
  next={{ label: 'Next', title: 'Selected work', to: '/#work', line: 'I design how AI products behave, and the interface that keeps people in control of it.' }}
>
  <section class="col hero work-head" aria-labelledby="h1">
    <div class="id">
      <h1 id="h1">The Vellum Stacks</h1>
      <p class="meta">2026 · Interactive, WebGL, sound</p>
    </div>
    <div class="about">
      <p>An impossible archive of translucent paper towers over black water, lit from openings in a roof you never see.</p>
      <p class="meta">Best on a desktop browser. Sound starts at your first click.</p>
    </div>
    <a class="btn enter" href={live}>Enter the work</a>
  </section>

  <section class="col sec" aria-label="Film">
    <figure class="fig">
      <div class="frame bare film">
        <video id="film" preload="none" playsinline poster={still.src} src={href('/art/vellum-stacks/opening.mp4')}></video>
        <button type="button" class="play" data-cursor="Play · 0:30" aria-label="Play the film, 30 seconds, with sound"><span>Play · 0:30</span></button>
      </div>
      <span class="meta under"><b>Film</b> · The opening, 0:30 — recorded from the live work, with sound.</span>
    </figure>
  </section>

  <section class="col sec snap" aria-label="Facts">
    <dl class="facts">
      <div><dt class="meta">Year</dt><dd>2026</dd></div>
      <div><dt class="meta">Medium</dt><dd>Custom software (three.js, WebGL 2), sound generated in the browser</dd></div>
      <div><dt class="meta">Dimensions</dt><dd>Variable; the whole browser window</dd></div>
      <div><dt class="meta">Interaction</dt><dd><span class="line">Drag to look</span><span class="line">Scroll, or W and S, to walk; A and D to turn</span><span class="line">Click to walk on</span><span class="line">Stay, and the paper rises</span></dd></div>
      <div><dt class="meta">Other readers</dt><dd>Simulated in this build. In the original, people who open it at the same time see each other reading.</dd></div>
      <div><dt class="meta">Credits</dt><dd><span class="line">Concept, art direction: Kyle Xu</span><span class="line">Built in dialogue with Claude</span></dd></div>
    </dl>
  </section>

  <section class="col sec chap" aria-labelledby="c-statement">
    <div class="head">
      <h2 id="c-statement">Statement</h2>
    </div>
    <div class="body">
      <p>An impossible archive: sheets of translucent paper stand like towers over black water and repeat without end. Rectangular openings in an unseen roof let light down. Every sheet hangs from a thread that runs up to the roof.</p>
      <p>The work has a single rule: the archive opens where it is read. Wherever a reader stands, the threads draw the paper up out of the way; the longer they stay, the wider the opening grows and the higher the paper rises, into the light near the roof, until the light reaches the water at their feet. When they leave, the paper comes down over minutes, a trace that slowly heals. One page, the one they read, stays up. The archive remembers where it has been read.</p>
      <p>The plan follows Junya Ishigami: no walls, only density. Paper gathers under the light, so the plan is the map of the light. On the horizon stands a city drawn in the same rectangles of light, mirrored in the water. The sound is made by the same rule and nothing is sampled: a hall that breathes with the light, the rustle of paper being drawn up, the creak of a thread under a large sheet, one low note when a page is left behind.</p>
    </div>
    <div class="figs">
      <Figure narrow bare src={approach} evidence="Still" name="The approach" note="the opening in the roof from below, the threads running up into its light" alt="Looking up at a bright rectangular opening in a dark roof; hundreds of fine threads run up into it, and translucent sheets stand beneath" />
      <Figure bare set="pair" items={[
        { src: reading, evidence: 'Still', name: 'Reading', note: 'the sheets around a reader drawn up on their threads, tilting toward the light', alt: 'Translucent sheets lifted and tilted on their threads, rising toward the light at the top of the frame' },
        { src: above, evidence: 'Still', name: 'A page left up', note: 'a large sheet held high at the top left, the city of light on the horizon', alt: 'A large sheet suspended high at the upper left; below, small rectangles of light on the horizon reflected in black water' },
      ]} />
      <Figure bare src={skyline} evidence="Still" name="The skyline" note="the city drawn in the same rectangles of light, mirrored in the water" alt="Sheets in the foreground before a horizon of small lit rectangles, mirrored in the dark water below" />
    </div>
  </section>

  <section class="col sec close" aria-label="Enter">
    <p class="stance">The archive opens where it is read.</p>
    <div class="go">
      <p>Best on a desktop browser. Sound starts at your first click.</p>
      <a class="btn" href={live}>Enter the work</a>
    </div>
  </section>

  <CursorLabel />
  <script is:inline>
    // The film: nothing loads until it is asked for; one click plays it with sound and hands over to
    // the browser's own controls.
    (function () {
      var v = document.getElementById('film'); if (!v) return;
      var frame = v.parentNode, play = frame.querySelector('.play');
      play.addEventListener('click', function () {
        v.controls = true; frame.classList.add('playing');
        var p = v.play(); if (p && p.catch) p.catch(function () {});
        v.focus();
      });
    })();
  </script>
</Sheet>
