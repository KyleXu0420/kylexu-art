---
// The cursor label (home.css .cursor): one element and its script, on any page whose links carry
// data-cursor="<word>". Pointer devices with hover only; touch, keyboard and forced colours never see it.
---
<div class="cursor" id="cursor" aria-hidden="true"></div>
<script is:inline>
  // The cursor label: over anything that carries data-cursor (a project card, an art plate, the film)
  // the pointer becomes that thing's own word — Case →, File ↗, View →, Play · 0:30 — so what a
  // click does is read before the click.
  // Mouse and pen only (a touch on a touchscreen laptop never shows it); the native arrow comes
  // back the moment the pointer leaves, on a native drag, on a scroll that moves the card away,
  // when the page is hidden, and under forced colours (home.css). The follow is time-based so
  // 120Hz and a throttled tab feel the same.
  (function () {
    if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    var el = document.getElementById('cursor'); if (!el) return;
    var root = document.documentElement;
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var x = 0, y = 0, tx = 0, ty = 0, cur = null, raf = 0, last = 0;
    function frame(now) {
      var f = still ? 1 : 1 - Math.pow(0.55, (now - last) / 16.7);   /* 0.45 per 60Hz frame */
      last = now; x += (tx - x) * f; y += (ty - y) * f;
      el.style.transform = 'translate3d(' + x + 'px,' + y + 'px,0) translate(-50%, -50%)';
      raf = (Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3) ? requestAnimationFrame(frame) : 0;
    }
    function on(a) { if (a !== cur) { cur = a; el.textContent = a.getAttribute('data-cursor'); } if (!el.classList.contains('on')) { x = tx; y = ty; el.classList.add('on'); root.classList.add('cursor-on'); } }
    function off() { cur = null; el.classList.remove('on'); root.classList.remove('cursor-on'); }
    function under(t) { return t && t.closest ? t.closest('[data-cursor]') : null; }
    document.addEventListener('pointermove', function (e) {
      if (e.pointerType === 'touch') { off(); return; }
      tx = e.clientX; ty = e.clientY;
      var a = under(e.target);
      if (a) on(a); else if (cur) off();
      if (!raf) { last = performance.now(); raf = requestAnimationFrame(frame); }
    }, { passive: true });
    document.addEventListener('scroll', function () { if (!cur) return; var a = under(document.elementFromPoint(tx, ty)); if (a) on(a); else off(); }, { passive: true });   /* the page moved under a resting pointer */
    document.addEventListener('pointerout', function (e) { if (!e.relatedTarget) off(); });
    document.addEventListener('dragstart', off);
    document.addEventListener('pointercancel', off);
    window.addEventListener('pagehide', off);
  })();
</script>
