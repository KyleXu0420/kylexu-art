---
import { Picture } from 'astro:assets';
import Sheet from '../layouts/Sheet.astro';
import { href } from '../lib/url';
import '../styles/home.css';
import tokensRaw from '../styles/tokens.css?raw';
import menolift from '../assets/img/menolift-screens.png';
import heygen from '../assets/img/heygen-after.png';

const observe = 'https://github.com/KyleXu0420/observe';
const droploft = 'https://www.figma.com/design/3nUKfaJoAkZQdlZwzpyFff/Dify-Demos?node-id=0-1';
const curio = 'https://www.figma.com/design/BiXcn2d7kNwzXtuw1aUGDx/Curio-Work?node-id=0-1';
const echo = 'https://doi.org/10.7302/29019';

// The proof under the claim: six colour roles from this site's own tokens.css, read from the
// file at build time — the name, the value it is given in light and in dark, and its comment —
// beside a swatch painted with the role itself, so the reader sees the token doing its job on
// the page they are reading. Nothing here is typed twice: if the file changes, so does this.
const ROLES = ['--bg', '--fg', '--fg-2', '--fg-3', '--line', '--fill'];
const lines = tokensRaw.split('\n');
function block(marker: string): Map<string, { value: string; note: string }> {
  const at = lines.findIndex((l) => l.startsWith(marker));
  const out = new Map();
  for (const l of lines.slice(at)) {
    const m = l.match(/^\s*(--[\w-]+):\s*([^;]+);\s*(?:\/\*\s*(.*?)\s*\*\/)?/);
    if (m) out.set(m[1], { value: m[2].trim(), note: m[3] ?? '' });
    else if (l.trim() === '}') break;
  }
  return out;
}
const light = block('/* @roles — light');
const dark = block('/* @roles — dark');
const roles = ROLES.map((name) => ({ name, light: light.get(name)!.value, dark: dark.get(name)!.value, note: light.get(name)!.note }));
const hy = (s: string) => s.replace(/--/g, '<span class="hy">--</span>');   // the two hyphens of a custom property, kept apart in a mono face whose hyphen is wide

const shot = { formats: ['avif', 'webp'] as const, widths: [640, 1248, 2496], sizes: '(max-width: 767px) 960px, (max-width: 1440px) 86.7vw, 1248px', loading: 'lazy' as const, decoding: 'async' as const };
const card = { formats: ['avif', 'webp'] as const, widths: [640, 1248, 2496], sizes: '(max-width: 1440px) 86.7vw, 1248px', loading: 'lazy' as const, decoding: 'async' as const };
---
<Sheet
  title="Kyle Xu — AI product designer · design engineer"
  description="Kyle Xu designs AI products in the codebase they ship from. Most recently Temper (a token architecture and the design-lint checkers that keep it honest) and Dify (Droploft, built end-to-end in code)."
>
  <section class="col hero" aria-labelledby="h1">
    <h1 class="display" id="h1">I design AI products <br class="br" />in the codebase they ship from. <br class="br" /><span class="pivot">Not in a file that describes it.</span></h1>
  </section>

  <section class="col sec" aria-label="The codebase: six colour roles from this site's own tokens.css, each shown with the colour it resolves to">
    <dl class="tok">
      {roles.map((r) => (
        <div class="grid">
          <dt set:html={hy(r.name)} />
          <dd class="v"><i class="sw" style={`--sw: var(${r.name})`} aria-hidden="true"></i><span class="l" set:html={hy(r.light)} /><span class="d" set:html={hy(r.dark)} /></dd>
          <dd class="n">{r.note}</dd>
        </div>
      ))}
    </dl>
    <p class="meta cap">src/styles/tokens.css</p>
  </section>

  <section class="col sec" id="work" aria-label="Work">
    <ul class="tl">
      <li>
        <span class="meta when">2026.07 – 2026.09</span>
        <div class="org"><b>Temper</b><span>Design Engineer (Contract)</span></div>
        <div class="what">
          <h2><a href={observe} rel="noopener">A two-layer token architecture and its <span class="nb">design-lint</span> checkers</a></h2>
          <p>Sole designer in the production repo, shipped to main. Hardcoded colour down 60%.</p>
        </div>
      </li>
      <li>
        <span class="meta when">2026.02 – 2026.06</span>
        <div class="org"><b>Dify (LangGenius)</b><span>AI Product Designer (Design Engineer)</span></div>
        <div class="what">
          <h2><a href={droploft} rel="noopener">Droploft</a></h2>
          <p>Designed and built end-to-end in code. A team knowledge base on a four-level information architecture, 30+ screens.</p>
        </div>
      </li>
      <li>
        <span class="meta when">2024.11 – 2025.12</span>
        <div class="org"><b>Curio Digital Therapeutics</b><span>Founding Product Designer</span></div>
        <div class="what">
          <h2><a href={curio} rel="noopener">MamaLift and MenoLift</a></h2>
          <p>Two FDA-cleared digital therapeutics, their design system and information architecture built from zero under clinical review.</p>
        </div>
        <div class="fig media"><Picture src={menolift} {...card} alt="Five MenoLift screens fanned on an indigo field: a community post, the daily garden, a day's plan, the uplift store with a streak, and the memory stand" /></div>
      </li>
      <li>
        <span class="meta when">2024.03 – 2024.11</span>
        <div class="org"><b>Infloww</b><span>Product Designer (AI Specialist)</span></div>
        <div class="what">
          <h2>An AI chat assistant</h2>
          <p>Shipped as an MVP, then payment and mass-messaging tools, designed with prompt engineers for the cases where the model is wrong.</p>
        </div>
      </li>
      <li>
        <span class="meta when">2023.06 – 2023.10</span>
        <div class="org"><b>Heygen</b><span>Product Design Intern</span></div>
        <div class="what">
          <h2><a href={href('/projects/heygen')}>The video editor, <span class="nb">re-architected</span> around the script</a></h2>
          <p>Script, canvas and timeline reorganised with an updated component library; then a 0→1 iOS companion MVP in three weeks.</p>
        </div>
        <div class="fig media pan"><Picture src={heygen} {...shot} alt="The Heygen editor timeline after the re-architecture: a playback bar, time markers and numbered clips" /></div>
      </li>
      <li>
        <span class="meta when">2022 – 2025</span>
        <div class="org"><b>University of Michigan</b><span>M.S. thesis</span></div>
        <div class="what">
          <h2><a href={echo} rel="noopener">Echo, a future-self avatar for behaviour change</a></h2>
          <p>An LLM-driven agent for everyday health behaviour, piloted and then deployed for 12 days with 36 users.</p>
        </div>
      </li>
      <li>
        <span class="meta when">2022.06 – 2022.08</span>
        <div class="org"><b>Eaton Corporation</b><span>UX Design Intern</span></div>
        <div class="what">
          <h2><a href={href('/projects/eaton')}>RapidLinkX</a></h2>
          <p>An IoT configuration tool for airport conveyor systems, with parameter editing and error monitoring.</p>
        </div>
      </li>
    </ul>
  </section>

  <Fragment slot="signoff">
    <p>Trained as an architect for six years before product. A building holds because someone decided what the parts are and what each is allowed to do, and wrote it down so it could be checked. I hold design to that rule: ship it as production code, make the decisions checkable, and study how people actually use AI.</p>
  </Fragment>
</Sheet>
