---
import { href } from '../lib/url';
const resume = 'https://drive.google.com/file/d/1XlaKtkU-4iRvNvgbC6oJTdFKX5hse0aw/view?usp=sharing';
interface Props {
  signoff?: boolean;                      // whether the page passed a sign-off paragraph
  next?: { title: string; to: string; line?: string };   // a case page's other case: a row above the contact rule, its claim beneath the title
}
const { signoff = false, next } = Astro.props;
---
<footer class="foot" id="contact">
  <div class="col">
    {signoff && <div class="close"><slot name="signoff" /></div>}
    {next && <div class="next"><span class="meta">Next case</span><div><a class="link" href={href(next.to)}>{next.title} →</a>{next.line && <p>{next.line}</p>}</div></div>}
    <div class="reach">
      <div class="who">
        <b>Kyle Xu<span class="cjk">徐匡泓</span></b>
        <span class="meta">they / them</span>
      </div>
      <ul>
        <li><a class="btn" href="mailto:kylexu@umich.edu">kylexu@umich.edu</a></li>
        <li><a class="link" href="https://www.linkedin.com/in/kyle-xu-a111161a4/" rel="noopener">LinkedIn ↗</a></li>
        <li><a class="link" href="https://github.com/KyleXu0420" rel="noopener">GitHub ↗</a></li>
        <li><a class="link" href={resume} rel="noopener">Resume ↗</a></li>
      </ul>
    </div>
  </div>
</footer>
