---
// A case page: Sheet, with the case's hero (eyebrow, claim, deck, the hero figure), the page's
// chapters, then the page's close (`close` slot: the line it ends on at the site's stance size
// and the paragraph that earns it). The page ends there. The way to the other case is one line in
// the footer, above the contact row (Sheet passes `next` down to it). The composition is case.css.
// Pass a `signoff` slot only when the page has something to say in the footer as well.
import Sheet from './Sheet.astro';
import '../styles/home.css';
import '../styles/case.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  eyebrow: string;
  deck?: string;
  next: { title: string; to: string };
}
const { title, description, ogImage, eyebrow, deck, next } = Astro.props;
---
<Sheet {title} {description} {ogImage} {next}>
  <section class="col hero" aria-labelledby="h1">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display" id="h1"><slot name="claim" /></h1>
    {deck && <p class="lead deck">{deck}</p>}
    <slot name="hero" />
  </section>

  <slot />

  {Astro.slots.has('close') && <section class="col sec close" aria-label="In one line"><slot name="close" /></section>}

  <slot name="signoff" slot="signoff" />
</Sheet>
