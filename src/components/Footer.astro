---
import { execSync } from 'node:child_process';

// Build stamp: the commit this page was built from, and the day. CI provides GITHUB_SHA;
// a local build asks git.
let commit = (process.env.GITHUB_SHA ?? '').slice(0, 7);
if (!commit) { try { commit = execSync('git rev-parse --short HEAD').toString().trim(); } catch { commit = 'local'; } }
const built = new Date().toISOString().slice(0, 10);
const resume = 'https://drive.google.com/file/d/1XlaKtkU-4iRvNvgbC6oJTdFKX5hse0aw/view?usp=sharing';
---
<footer class="foot" id="contact">
  <div class="col">
    <div class="row">
      <div class="who">
        <b>Kyle Xu<span class="cjk">徐匡泓</span></b>
        <span class="meta">they / them · AI product designer · design engineer</span>
      </div>
      <div class="reach">
        <a class="btn" href="mailto:kylexu@umich.edu">Get in touch →</a>
        <ul>
          <li><a class="link" href="mailto:kylexu@umich.edu">kylexu@umich.edu</a></li>
          <li><a class="link" href="https://www.linkedin.com/in/kyle-xu-a111161a4/" rel="noopener">LinkedIn ↗</a></li>
          <li><a class="link" href="https://github.com/KyleXu0420" rel="noopener">GitHub ↗</a></li>
          <li><a class="link" href={resume} rel="noopener">Resume (PDF) ↗</a></li>
        </ul>
      </div>
    </div>
    <div class="fine">
      <span>© 2026 Kyle Xu</span>
      <span>Hand-written HTML and CSS, deployed from GitHub. No template, no tracker.</span>
      <span><a class="link" href="https://github.com/KyleXu0420/kylexu-art" rel="noopener">Source</a> · built {built} from {commit}</span>
    </div>
  </div>
</footer>
